# Referans: Projede zaten .env varsa onu kullanin. Kullanmadiginiz servislerin satirlarini .env'den silebilirsiniz.
#
# ========== ZORUNLU ==========
PORT=3006
NODE_ENV=production
# Frontend URL. Production: snapsell.website
PUBLIC_APP_URL=https://snapsell.website
APP_DOMAIN=https://snapsell.website
# CORS: Frontend origin'leri (virgulle ayrilmis).
ALLOWED_ORIGINS=https://snapsell.website,https://www.snapsell.website

# Supabase - veritabani ve kimlik dogrulama (Dashboard > Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
# Frontend (Vite) icin Supabase degiskenleri (build zamaninda gomulur)
# Vercel: SUPABASE_URL ile AYNI degerleri kullanin — VITE_ prefix ZORUNLU.
# Vercel Dashboard > Settings > Environment Variables: Production + Preview'a ekleyin; sonra Redeploy.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key
# Google OAuth dönüş adresi — Supabase Redirect URLs ile birebir aynı olmalı (örn. /hesap-ayarlari).
# VITE_AUTH_REDIRECT_URL=https://snapsell.website/hesap-ayarlari
# İstemci auth logları (getSession / getUser / AUTH EVENT) — sadece debug
# VITE_DEBUG_AUTH=true
# Frontend: API istekleri aynı sitede /api ise BOS birakin (Vercel varsayilan).
# Sadece backend baska host'ta ise: VITE_API_BASE_URL=https://api.example.com
# VITE_API_BASE_URL=
# Vercel serverless proxy (saas-design-extracted/api): backend kökü, sonda / yok
# API_PROXY_TARGET=https://your-backend.example.com
# Google ile giris: Supabase > Authentication > Providers > Google (Client ID/Secret)
# ve URL Configuration > Redirect URLs: https://alanadiniz.com/** , https://*.vercel.app/**
# Server-side (server.js, Vercel API): RLS'yi asar; gizli tutun
SUPABASE_SERVICE_ROLE_KEY=

ADMIN_PASSWORD=guclu_bir_sifre
# Sunucudaki admin panel / ozel API haklari (PhotoRoom vb.). Bos birakilirsa e-posta ile admin yoktur.
# NOT: Kayit/dogrulama e-postalari Supabase tarafindan gonderilir; alici adresi Dashboard > Auth ayarlarindadir, bu degiskenle ilgili degildir.
ADMIN_EMAIL=admin@yourdomain.com
OPENAI_API_KEY=sk-...

# ========== HELIA AI (yalnizca Railway — frontend'e ASLA koymayin) ==========
HELIA_API_KEY=
HELIA_BASE_URL=
# Opsiyonel: model adi (OpenAI-uyumlu endpoint icin). Handle GEREKMEZ.
# HELIA_MODEL=default
# Opsiyonel: yalnizca Helvia Events API kullaniyorsaniz
# HELIA_HANDLE=

# ========== GORSEL DUZENLEME ==========
# Vercel serverless (/api/photoroom/pipeline) ve server.js icin zorunlu.
PHOTOROOM_API_KEY=

# Replicate - Sadece PhotoRoom kullanmiyorsaniz bu 3 satiri silin.
# REPLICATE_API_TOKEN=r8_...
# REPLICATE_ALLOWED_EMAILS=email1@example.com
# REPLICATE_BRIA_PACKSHOT_VERSION=

# ========== KULLANMIYORSANIZ .env'DEN SILEBILIRSINIZ ==========
# LEONARDO_API_KEY=
# PIXIAN_API_ID=
# PIXIAN_API_SECRET=
# PIXIAN_TEST=true
# SERPAPI_API_KEY=
# EXA_API_KEY=
# PRO_PLAN_DEMO=true

# ========== SHOPIER ODEME ==========
SHOPIER_PAT=
SHOPIER_CLIENT_ID=
SHOPIER_CLIENT_SECRET=
SHOPIER_CALLBACK_URL=

# ========== LEMON SQUEEZY (abonelik — canlı / LIVE) ==========
# Railway ve Vercel: aynı canlı değerleri kullanın; sonra redeploy.
# LEMON_SQUEEZY_API_KEY=...   (Developers → API Keys; canlı anahtar sk_live_, lem_live_ veya eyJ… JWT olabilir)
# Store ID: canlı mağaza (Dashboard → Settings → Stores).
# Variant ID: canlı Products → [ürün] → Variants (sayısal ID).
# Webhook URL: https://ALANINIZ/api/webhook/lemonsqueezy veya https://ALANINIZ/api/webhook
# İmza: Lemon panelindeki canlı webhook secret = LEMON_SQUEEZY_WEBHOOK_SECRET
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_MONTHLY_PLAN=
LEMON_SQUEEZY_VARIANT_PRO_PLAN=
LEMON_SQUEEZY_VARIANT_YEARLY_PLAN=
LEMON_SQUEEZY_VARIANT_ADDON=
LEMON_SQUEEZY_WEBHOOK_SECRET=

# ========== RESEND (abonelik hoş geldin e-postası; Lemon webhook sonrası) ==========
# Boş bırakılırsa e-posta gönderilmez. from adresi Resend’de domain doğrulaması gerektirir.
# RESEND_API_KEY=re_xxxxx
# RESEND_FROM=SnapSell <onboarding@mail.snapsell.website>
# RESEND_REPLY_TO=snapsell.destek@gmail.com
# RESEND_DASHBOARD_URL=https://snapsell.website/dashboard

# ========== CRON (Yillik plan aylik kredi) ==========
CRON_SECRET=
