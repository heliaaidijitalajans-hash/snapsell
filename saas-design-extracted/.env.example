# Build-time (Vite). Production’da ortam değişkenleriyle doldurun; gerçek anahtarları repoya yazmayın.

# Backend API – istemci /api istekleri (boşsa aynı origin)
# VITE_API_BASE_URL=https://your-api.example.com

# Uygulama ana URL (paylaşım, yönlendirme)
# VITE_APP_URL=https://www.example.com

# Supabase – Dashboard > Project Settings > API: Project URL ve anon (public) key
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_key

# Vercel’de saas-design-extracted/api proxy kullanıyorsanız (opsiyonel):
# API_PROXY_TARGET=https://your-api.example.com
