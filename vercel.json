{
  "installCommand": "npm install && npm install --prefix saas-design-extracted",
  "buildCommand": "npm run build",
  "outputDirectory": "saas-design-extracted/dist",
  "crons": [
    {
      "path": "/api/cron/refill-yearly-credits",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
